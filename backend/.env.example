# Copy this file to .env and fill in your values
GROQ_API_KEY=key

# Optional overrides
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./onboarding_agent.db
# GROQ_MODEL_NAME="openai/gpt-oss-20b
# QA_TOP_K=5

# Comma-separated extra CORS origins for a deployed frontend, e.g. Vercel.
# localhost is always allowed separately, so this is only needed in
# production.
# ALLOWED_ORIGINS=https://your-app.vercel.app
# Free-tier time-budget guardrails for indexing — fail fast on an oversized
# repo instead of silently timing out. Defaults are conservative; tune
# against the timing breakdown /repos/index logs for each request.
# MAX_FILES_TO_INDEX=80
# MAX_CHUNKS_TO_INDEX=400
# MAX_FILE_SIZE_BYTES=100000